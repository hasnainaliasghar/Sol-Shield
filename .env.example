# Build-time only (never shipped to browser)
NASA_API_KEY=DEMO_KEY

# Server-side only (Vercel env var OR Railway env var — never prefix with VITE_)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Railway backend URL (set this in Vercel env vars after Railway deploy)
# Leave empty to use Vercel serverless /api/coach instead
VITE_RAILWAY_API_URL=

# Browser-safe (protected by Row Level Security in Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Feature flags
VITE_FEATURE_AI=true
VITE_FEATURE_LEADERBOARD=true

# Railway server only
PORT=3001
FRONTEND_URL=https://your-app.vercel.app

